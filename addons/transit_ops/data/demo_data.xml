             ══════════════════════════════════════════════════════════════════ -->

        <!-- Trip 1: Completed — Mumbai → Delhi, VAN-05, Alex -->
        <record id="demo_trip_1" model="transit.trip">
            <field name="name">TRIP/0001</field>
            <field name="source">Mumbai</field>
            <field name="destination">Delhi</field>
            <field name="vehicle_id" ref="demo_vehicle_1"/>
            <field name="driver_id" ref="demo_driver_1"/>
            <field name="cargo_weight">450.0</field>
            <field name="planned_distance">1400.0</field>
            <field name="actual_distance">1432.0</field>
            <field name="fuel_consumed">112.0</field>
            <field name="final_odometer">13240.0</field>
            <field name="trip_revenue">3500.0</field>
            <field name="date_planned">2026-07-02 08:00:00</field>
            <field name="date_dispatched">2026-07-02 08:15:00</field>
            <field name="date_completed">2026-07-03 18:30:00</field>
            <field name="state">completed</field>
