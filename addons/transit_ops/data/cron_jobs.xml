<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Odoo 18: ir.cron delegates to ir.actions.server.
            Fields model_id, state, code come from the server action delegate.
            numbercall is removed in Odoo 18 (runs indefinitely by default).
        -->

        <!-- Cron: Check vehicles due for maintenance -->
        <record id="ir_cron_check_maintenance_due" model="ir.cron">
            <field name="name">TransitOps: Check Maintenance Due</field>
            <field name="model_id" ref="model_transit_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_maintenance_due()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Cron: Check driver license expiry -->
        <record id="ir_cron_check_license_expiry" model="ir.cron">
            <field name="name">TransitOps: Check Driver License Expiry</field>
            <field name="model_id" ref="model_transit_driver"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_license_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
