<?xml version="1.0" encoding="utf-8"?>
<!--
    Menu Structure
    ==============
    Owner: Person D

    Full navigation tree for TransitOps.
    Menu visibility is controlled via 'groups' attribute.

    Structure:
      TransitOps (root)
      ├── Dashboard
      ├── Fleet
      │   ├── Vehicles
      │   └── Drivers
      ├── Operations
      │   ├── Trips
      │   └── Maintenance
      ├── Finance
      │   ├── Fuel Logs
      │   └── Expenses
      └── Reports
          └── Fleet Analytics (placeholder — Person A fills this)
-->
<odoo>
    <data>

        <!-- Root menu item -->
        <menuitem id="menu_transit_root"
                  name="TransitOps"
                  sequence="10"
                  web_icon="transit_ops,static/description/icon.png"/>

        <!-- ── Dashboard ─────────────────────────────────────────────────────── -->
        <menuitem id="menu_transit_dashboard"
                  name="Dashboard"
                  parent="menu_transit_root"
                  action="action_transit_dashboard"
                  sequence="10"/>

        <!-- ── Fleet ─────────────────────────────────────────────────────────── -->
        <menuitem id="menu_transit_fleet"
                  name="Fleet"
                  parent="menu_transit_root"
                  sequence="20"/>

        <menuitem id="menu_transit_vehicles"
                  name="Vehicles"
                  parent="menu_transit_fleet"
                  action="action_transit_vehicle"
                  sequence="10"/>

        <menuitem id="menu_transit_drivers"
                  name="Drivers"
                  parent="menu_transit_fleet"
                  action="action_transit_driver"
                  sequence="20"/>

        <!-- ── Operations ────────────────────────────────────────────────────── -->
        <menuitem id="menu_transit_operations"
                  name="Operations"
                  parent="menu_transit_root"
                  sequence="30"/>

        <menuitem id="menu_transit_trips"
                  name="Trips"
                  parent="menu_transit_operations"
                  action="action_transit_trip"
                  sequence="10"/>

        <menuitem id="menu_transit_maintenance"
                  name="Maintenance"
                  parent="menu_transit_operations"
                  action="action_transit_maintenance"
                  sequence="20"/>

        <!-- ── Finance ───────────────────────────────────────────────────────── -->
        <menuitem id="menu_transit_finance"
                  name="Finance"
                  parent="menu_transit_root"
                  sequence="40"
                  groups="transit_ops.group_transit_fleet_manager,transit_ops.group_transit_financial_analyst"/>

        <menuitem id="menu_transit_fuel_logs"
                  name="Fuel Logs"
                  parent="menu_transit_finance"
                  action="action_transit_fuel_log"
                  sequence="10"
                  groups="transit_ops.group_transit_fleet_manager,transit_ops.group_transit_financial_analyst"/>

        <menuitem id="menu_transit_expenses"
                  name="Expenses"
                  parent="menu_transit_finance"
                  action="action_transit_expense"
                  sequence="20"
                  groups="transit_ops.group_transit_fleet_manager,transit_ops.group_transit_financial_analyst"/>

        <!-- ── Reports ───────────────────────────────────────────────────────── -->
        <menuitem id="menu_transit_reports"
                  name="Reports"
                  parent="menu_transit_root"
                  sequence="50"
                  groups="transit_ops.group_transit_fleet_manager,transit_ops.group_transit_financial_analyst"/>

        <!-- TODO (Person A): Add report action here when reports are ready -->
        <!-- <menuitem id="menu_transit_analytics"
                  name="Fleet Analytics"
                  parent="menu_transit_reports"
                  action="action_transit_fleet_report"
                  sequence="10"/> -->

    </data>
</odoo>
