<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── List View ─────────────────────────────────────────────────────── -->
        <record id="view_transit_trip_list" model="ir.ui.view">
            <field name="name">transit.trip.list</field>
            <field name="model">transit.trip</field>
            <field name="arch" type="xml">
                <list string="Trips"
                      decoration-success="state == 'completed'"
                      decoration-info="state == 'dispatched'"
                      decoration-muted="state == 'cancelled'">
                    <field name="name"/>
                    <field name="date_planned"/>
                    <field name="source"/>
                    <field name="destination"/>
                    <field name="vehicle_id"/>
                    <field name="driver_id"/>
                    <field name="cargo_weight" sum="Total Cargo (kg)"/>
                    <field name="planned_distance" optional="show"/>
                    <field name="actual_distance" optional="hide"/>
                    <field name="fuel_efficiency" optional="hide"/>
                    <field name="trip_revenue" optional="hide" sum="Total Revenue"/>
                    <field name="trip_cost" optional="hide" sum="Total Cost"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- ── Form View ─────────────────────────────────────────────────────── -->
        <record id="view_transit_trip_form" model="ir.ui.view">
            <field name="name">transit.trip.form</field>
            <field name="model">transit.trip</field>
            <field name="arch" type="xml">
                <form string="Trip">
                    <header>
                        <button name="action_dispatch" string="Dispatch" type="object"
                                class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_complete" string="Complete Trip" type="object"
                                class="btn-success"
                                invisible="state != 'dispatched'"/>
                        <button name="action_cancel" string="Cancel" type="object"
                                class="btn-danger"
                                invisible="state not in ('draft', 'dispatched')"/>
                        <button name="action_reset_draft" string="Reset to Draft" type="object"
                                class="btn-secondary"
                                invisible="state != 'cancelled'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,dispatched,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" readonly="1"/></h1>
                        </div>
                        <group>
                            <!-- Route & Schedule -->
                            <group string="Route">
                                <field name="source"
                                       readonly="state in ('dispatched', 'completed', 'cancelled')"/>
                                <field name="destination"
                                       readonly="state in ('dispatched', 'completed', 'cancelled')"/>
                                <field name="planned_distance"
                                       readonly="state in ('dispatched', 'completed', 'cancelled')"/>
                            </group>
                            <group string="Schedule">
                                <field name="date_planned"
                                       readonly="state in ('dispatched', 'completed', 'cancelled')"/>
                                <field name="date_dispatched" readonly="1"
                                       invisible="not date_dispatched"/>
                                <field name="date_completed" readonly="1"
                                       invisible="not date_completed"/>
                            </group>
                        </group>
                        <group>
                            <!-- Assignment — domain-restricted to only Available vehicles/drivers -->
                            <group string="Assignment">
                                <field name="vehicle_id"
                                       domain="[('status','=','available')]"
                                       readonly="state in ('dispatched', 'completed', 'cancelled')"/>
                                <field name="driver_id"
                                       domain="[('status','=','available'),('is_license_expired','=',False)]"
                                       readonly="state in ('dispatched', 'completed', 'cancelled')"/>
                                <field name="cargo_weight"
                                       readonly="state in ('dispatched', 'completed', 'cancelled')"/>
                            </group>
                            <!-- Financial -->
                            <group string="Financial">
                                <field name="trip_revenue"/>
                                <field name="trip_cost" readonly="1"/>
                            </group>
                        </group>

                        <!-- Completion section — only visible once dispatched -->
                        <group string="Completion Details"
                               invisible="state not in ('dispatched', 'completed')">
                            <field name="actual_distance" readonly="state == 'completed'"/>
                            <field name="fuel_consumed" readonly="state == 'completed'"/>
                            <field name="final_odometer" readonly="state == 'completed'"/>
                            <field name="fuel_efficiency" readonly="1"/>
                        </group>

                        <notebook>
                            <page string="Fuel Logs">
                                <field name="fuel_log_ids">
                                    <list>
                                        <field name="date"/>
                                        <field name="liters"/>
                                        <field name="cost" sum="Total Fuel Cost"/>
                                        <field name="odometer_reading"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Expenses">
                                <field name="expense_ids">
                                    <list>
                                        <field name="date"/>
                                        <field name="expense_type"/>
                                        <field name="amount" sum="Total Expenses"/>
                                        <field name="description"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ── Kanban View ───────────────────────────────────────────────────── -->
        <record id="view_transit_trip_kanban" model="ir.ui.view">
            <field name="name">transit.trip.kanban</field>
            <field name="model">transit.trip</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="source"/>
                    <field name="destination"/>
                    <field name="vehicle_id"/>
                    <field name="driver_id"/>
                    <field name="state"/>
                    <field name="cargo_weight"/>
                    <field name="date_planned"/>
                    <field name="fuel_efficiency"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_card">
                                <div class="d-flex justify-content-between">
                                    <strong><field name="name"/></strong>
                                    <field name="state" widget="badge"/>
                                </div>
                                <div class="mt-1">
                                    📍 <field name="source"/> → <field name="destination"/>
                                </div>
                                <div>
                                    🚛 <field name="vehicle_id"/>
                                </div>
                                <div>
                                    👤 <field name="driver_id"/>
                                </div>
                                <div>
                                    📦 <field name="cargo_weight"/> kg
                                </div>
                                <div class="text-muted small" invisible="not date_planned">
                                    🗓️ <field name="date_planned" widget="date"/>
                                </div>
                                <div invisible="not fuel_efficiency">
                                    ⛽ <field name="fuel_efficiency"/> km/L
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ── Search View ───────────────────────────────────────────────────── -->
        <record id="view_transit_trip_search" model="ir.ui.view">
            <field name="name">transit.trip.search</field>
            <field name="model">transit.trip</field>
            <field name="arch" type="xml">
                <search string="Search Trips">
                    <field name="name"/>
                    <field name="source"/>
                    <field name="destination"/>
                    <field name="vehicle_id"/>
                    <field name="driver_id"/>
                    <separator/>
                    <!-- State filters -->
                    <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                    <filter string="Dispatched" name="dispatched" domain="[('state','=','dispatched')]"/>
                    <filter string="Completed" name="completed" domain="[('state','=','completed')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state','=','cancelled')]"/>
                    <separator/>
                    <!-- Date filters -->
                    <filter string="Today" name="today"
                            domain="[('date_planned','&gt;=',datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')),
                                     ('date_planned','&lt;=',datetime.datetime.now().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <filter string="This Week" name="this_week"
                            domain="[('date_planned','&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter string="This Month" name="this_month"
                            domain="[('date_planned','&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="State" name="group_state" context="{'group_by':'state'}"/>
                        <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                        <filter string="Driver" name="group_driver" context="{'group_by':'driver_id'}"/>
                        <filter string="Planned Date" name="group_date" context="{'group_by':'date_planned:month'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ── Window Action ─────────────────────────────────────────────────── -->
        <record id="action_transit_trip" model="ir.actions.act_window">
            <field name="name">Trips</field>
            <field name="res_model">transit.trip</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="search_view_id" ref="view_transit_trip_search"/>
            <field name="context">{'search_default_dispatched': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first trip!
                </p>
                <p>
                    Trips track the full journey lifecycle from draft to completion,
                    enforcing vehicle capacity, driver availability, and status rules.
                </p>
            </field>
        </record>

    </data>
</odoo>
