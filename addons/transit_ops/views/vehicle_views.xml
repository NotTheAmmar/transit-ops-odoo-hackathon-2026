<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Kanban View ───────────────────────────────────────────────────── -->
        <record id="view_transit_vehicle_kanban" model="ir.ui.view">
            <field name="name">transit.vehicle.kanban</field>
            <field name="model">transit.vehicle</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" sample="1">
                    <field name="id"/>
                    <field name="name"/>
                    <field name="registration_number"/>
                    <field name="status"/>
                    <field name="image_1920"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                                <t t-if="record.image_1920.raw_value">
                                    <div class="o_kanban_image_fill_left d-none d-md-block"
                                         t-attf-style="background-image:url('#{kanban_image('transit.vehicle', 'image_1920', record.id.raw_value)}')"/>
                                </t>
                                <t t-else="">
                                    <div class="o_kanban_image_fill_left d-none d-md-block"
                                         t-attf-style="background-image:url('/web/static/img/placeholder.png')"/>
                                </t>
                                <div class="o_kanban_image d-md-none d-block">
                                    <img t-if="record.image_1920.raw_value" 
                                         t-att-src="kanban_image('transit.vehicle', 'image_1920', record.id.raw_value)" alt="Vehicle"/>
                                    <img t-else="" src="/web/static/img/placeholder.png" alt="Vehicle"/>
                                </div>
                                <div class="oe_kanban_details">
                                    <strong class="o_kanban_record_title">
                                        <field name="registration_number"/>
                                    </strong>
                                    <div class="o_kanban_tags_section">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_kanban_record_bottom mt-2">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="status" widget="badge" 
                                                   decoration-success="status == 'available'"
                                                   decoration-warning="status == 'in_shop'"
                                                   decoration-info="status == 'on_trip'"
                                                   decoration-danger="status == 'retired'"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ── List View ─────────────────────────────────────────────────────── -->
        <record id="view_transit_vehicle_list" model="ir.ui.view">
            <field name="name">transit.vehicle.list</field>
            <field name="model">transit.vehicle</field>
            <field name="arch" type="xml">
                <list string="Vehicles"
                      decoration-danger="status == 'retired'"
                      decoration-warning="status == 'in_shop'"
                      decoration-info="status == 'on_trip'"
                      decoration-success="status == 'available'">
                    <field name="registration_number" optional="show"/>
                    <field name="name" optional="show"/>
                    <field name="vehicle_type" optional="show"/>
                    <field name="max_load_capacity" optional="hide"/>
                    <field name="odometer" optional="show"/>
                    <field name="region" optional="hide"/>
                    <field name="health_score" widget="progressbar" optional="show"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'available'"
                           decoration-warning="status == 'in_shop'"
                           decoration-info="status == 'on_trip'"
                           decoration-danger="status == 'retired'" optional="show"/>
                    <field name="total_operational_cost" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- ── Form View ─────────────────────────────────────────────────────── -->
        <record id="view_transit_vehicle_form" model="ir.ui.view">
            <field name="name">transit.vehicle.form</field>
            <field name="model">transit.vehicle</field>
            <field name="arch" type="xml">
                <form string="Vehicle">
                    <header>
                        <field name="status" widget="statusbar"
                               statusbar_visible="available,on_trip,in_shop,retired"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Healthy" bg_color="text-bg-success" invisible="health_badge != 'healthy'"/>
                        <widget name="web_ribbon" title="Service Due" bg_color="text-bg-warning" invisible="health_badge != 'warning'"/>
                        <widget name="web_ribbon" title="Critical" bg_color="text-bg-danger" invisible="health_badge != 'critical'"/>

                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object"
                                    name="action_view_trips" icon="fa-truck">
                                <field name="trip_count" string="Trips" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object"
                                    name="action_view_maintenance" icon="fa-wrench">
                                <field name="maintenance_count" string="Maintenance" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object"
                                    name="action_view_fuel_logs" icon="fa-tint">
                                <field name="fuel_log_count" string="Fuel Logs" widget="statinfo"/>
                            </button>
                            <button class="oe_stat_button" type="object"
                                    name="action_view_expenses" icon="fa-money">
                                <field name="expense_count" string="Expenses" widget="statinfo"/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                            <h1>
                                <field name="registration_number" placeholder="REG-001"/>
                            </h1>
                            <h2>
                                <field name="name" placeholder="Vehicle Name / Model"/>
                            </h2>
                        </div>

                        <!-- KPIs requested by Odoo Architect -->
                        <group string="Fleet Intelligence &amp; Metrics">
                            <group>
                                <field name="health_score" widget="progressbar"/>
                                <field name="health_badge" invisible="1"/>
                                <field name="fleet_recommendation" readonly="1" decoration-info="1"/>
                            </group>
                            <group>
                                <field name="total_operational_cost" widget="monetary" string="Total Operational Cost"/>
                                <field name="total_fuel_cost" widget="monetary" string="Total Fuel Cost"/>
                                <field name="last_maintenance_date" string="Last Service Date"/>
                                <field name="next_recommended_maintenance" string="Next Service Date"/>
                            </group>
                        </group>

                        <group>
                            <group string="Identity">
                                <field name="vehicle_type"/>
                                <field name="make"/>
                                <field name="model_year"/>
                                <field name="region"/>
                                <field name="acquisition_cost"/>
                            </group>
                            <group string="Capacity &amp; Analytics">
                                <field name="max_load_capacity"/>
                                <field name="odometer"/>
                                <field name="average_fuel_efficiency"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Maintenance Schedule">
                                <group>
                                    <field name="last_maintenance_odometer"/>
                                    <field name="service_interval_km"/>
                                    <field name="maintenance_due"/>
                                </group>
                            </page>
                            <page string="Financial Summary">
                                <group>
                                    <field name="total_fuel_cost" readonly="1"/>
                                    <field name="total_maintenance_cost" readonly="1"/>
                                    <field name="total_other_expenses" readonly="1"/>
                                    <field name="total_operational_cost" readonly="1"/>
                                    <field name="vehicle_roi" readonly="1"/>
                                </group>
                            </page>
                            <page string="Compliance &amp; Insurance">
                                <group>
                                    <field name="insurance_policy_number"/>
                                    <field name="insurance_expiry_date"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ── Search View ───────────────────────────────────────────────────── -->
        <record id="view_transit_vehicle_search" model="ir.ui.view">
            <field name="name">transit.vehicle.search</field>
            <field name="model">transit.vehicle</field>
            <field name="arch" type="xml">
                <search string="Search Vehicles">
                    <field name="registration_number"/>
                    <field name="name"/>
                    <field name="region"/>
                    <separator/>
                    <filter string="Available" name="available" domain="[('status','=','available')]"/>
                    <filter string="On Trip" name="on_trip" domain="[('status','=','on_trip')]"/>
                    <filter string="In Shop" name="in_shop" domain="[('status','=','in_shop')]"/>
                    <filter string="Retired" name="retired" domain="[('status','=','retired')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Type" name="group_type" context="{'group_by':'vehicle_type'}"/>
                        <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                        <filter string="Region" name="group_region" context="{'group_by':'region'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ── Window Action ─────────────────────────────────────────────────── -->
        <record id="action_transit_vehicle" model="ir.actions.act_window">
            <field name="name">Vehicles</field>
            <field name="res_model">transit.vehicle</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="view_transit_vehicle_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register your first vehicle!
                </p>
            </field>
        </record>

    </data>
</odoo>
