<?xml version="1.0" encoding="utf-8"?>
<!-- Owner: Person C -->
<odoo>
    <data>

        <record id="view_transit_maintenance_list" model="ir.ui.view">
            <field name="name">transit.maintenance.list</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <list string="Maintenance Logs"
                      decoration-warning="state == 'open'"
                      decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <field name="maintenance_type"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="cost"/>
                    <field name="state" widget="badge"
                           decoration-secondary="state == 'draft'"
                           decoration-warning="state == 'open'"
                           decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <record id="view_transit_maintenance_form" model="ir.ui.view">
            <field name="name">transit.maintenance.form</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <form string="Maintenance Log">
                    <header>
                        <button name="action_open" string="Start Maintenance" type="object"
                                class="btn-warning" invisible="state != 'draft'"/>
                        <button name="action_close" string="Close — Maintenance Done" type="object"
                                class="btn-success" invisible="state != 'open'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,open,done"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Details">
                                <field name="name"/>
                                <field name="vehicle_id"/>
                                <field name="maintenance_type"/>
                                <field name="description"/>
                            </group>
                            <group string="Schedule &amp; Cost">
                                <field name="date_start"/>
                                <field name="date_end" readonly="state != 'done'"/>
                                <field name="cost"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_transit_maintenance_search" model="ir.ui.view">
            <field name="name">transit.maintenance.search</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <search string="Search Maintenance">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <filter string="Open" name="open" domain="[('state','=','open')]"/>
                    <filter string="Done" name="done" domain="[('state','=','done')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by':'maintenance_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_transit_maintenance" model="ir.actions.act_window">
            <field name="name">Maintenance</field>
            <field name="res_model">transit.maintenance</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_transit_maintenance_search"/>
        </record>

    </data>
</odoo>
