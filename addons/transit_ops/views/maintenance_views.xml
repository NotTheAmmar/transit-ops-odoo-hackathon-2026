<?xml version="1.0" encoding="utf-8"?>
<!-- Owner: Person C -->
<odoo>
    <data>

        <!-- ── Kanban View ───────────────────────────────────────────────────── -->
        <record id="view_transit_maintenance_kanban" model="ir.ui.view">
            <field name="name">transit.maintenance.kanban</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_mobile">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <field name="maintenance_type"/>
                    <field name="state"/>
                    <field name="cost"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                    <div class="o_dropdown_kanban dropdown">
                                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'open': 'warning', 'done': 'success'}}"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="vehicle_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="maintenance_type"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <strong><field name="cost" widget="monetary"/></strong>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ── Calendar View ─────────────────────────────────────────────────── -->
        <record id="view_transit_maintenance_calendar" model="ir.ui.view">
            <field name="name">transit.maintenance.calendar</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <calendar string="Maintenance Schedule" date_start="date_start" date_stop="date_end" color="vehicle_id" mode="month">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <field name="state"/>
                </calendar>
            </field>
        </record>

        <!-- ── Pivot View ────────────────────────────────────────────────────── -->
        <record id="view_transit_maintenance_pivot" model="ir.ui.view">
            <field name="name">transit.maintenance.pivot</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <pivot string="Maintenance Analysis">
                    <field name="vehicle_id" type="row"/>
                    <field name="maintenance_type" type="col"/>
                    <field name="cost" type="measure"/>
                </pivot>
            </field>
        </record>

        <!-- ── Graph View ────────────────────────────────────────────────────── -->
        <record id="view_transit_maintenance_graph" model="ir.ui.view">
            <field name="name">transit.maintenance.graph</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <graph string="Maintenance Trends" type="bar">
                    <field name="date_start" type="row"/>
                    <field name="vehicle_id" type="col"/>
                    <field name="cost" type="measure"/>
                </graph>
            </field>
        </record>

        <!-- ── List View ─────────────────────────────────────────────────────── -->
        <record id="view_transit_maintenance_list" model="ir.ui.view">
            <field name="name">transit.maintenance.list</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <list string="Maintenance Logs"
                      decoration-warning="state == 'open'"
                      decoration-success="state == 'done'">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <field name="maintenance_type"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="cost"/>
                    <field name="state" widget="badge"
                           decoration-secondary="state == 'draft'"
                           decoration-warning="state == 'open'"
                           decoration-success="state == 'done'"/>
                </list>
            </field>
        </record>

        <!-- ── Form View ─────────────────────────────────────────────────────── -->
        <record id="view_transit_maintenance_form" model="ir.ui.view">
            <field name="name">transit.maintenance.form</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <form string="Maintenance Log">
                    <header>
                        <button name="action_open" string="Start Maintenance" type="object"
                                class="btn-warning" invisible="state != 'draft'"/>
                        <button name="action_close" string="Close — Maintenance Done" type="object"
                                class="btn-success" invisible="state != 'open'"/>
                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,open,done"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Details">
                                <field name="name"/>
                                <field name="vehicle_id"/>
                                <field name="maintenance_type"/>
                                <field name="description"/>
                            </group>
                            <group string="Schedule &amp; Cost">
                                <field name="date_start"/>
                                <field name="date_end" readonly="state != 'done'"/>
                                <field name="cost"/>
                            </group>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- ── Search View ───────────────────────────────────────────────────── -->
        <record id="view_transit_maintenance_search" model="ir.ui.view">
            <field name="name">transit.maintenance.search</field>
            <field name="model">transit.maintenance</field>
            <field name="arch" type="xml">
                <search string="Search Maintenance">
                    <field name="name"/>
                    <field name="vehicle_id"/>
                    <filter string="Open" name="open" domain="[('state','=','open')]"/>
                    <filter string="Done" name="done" domain="[('state','=','done')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Vehicle" name="group_vehicle" context="{'group_by':'vehicle_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by':'maintenance_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ── Window Action ─────────────────────────────────────────────────── -->
        <record id="action_transit_maintenance" model="ir.actions.act_window">
            <field name="name">Maintenance</field>
            <field name="res_model">transit.maintenance</field>
            <field name="view_mode">kanban,list,calendar,pivot,graph,form</field>
            <field name="search_view_id" ref="view_transit_maintenance_search"/>
        </record>

    </data>
</odoo>
