<?xml version="1.0" encoding="utf-8"?>
<!--
    Driver Views
    ============
    Owner: Person A

    TODO:
    1. Form view: Add license expiry warning banner when is_license_expired = True
    2. Form view: Add safety score progress bar widget
    3. List view: Highlight rows with expired licenses in red
    4. Search: Add filter for "Expired License"
-->
<odoo>
    <data>

        <!-- ── List View ─────────────────────────────────────────────────────── -->
        <record id="view_transit_driver_list" model="ir.ui.view">
            <field name="name">transit.driver.list</field>
            <field name="model">transit.driver</field>
            <field name="arch" type="xml">
                <list string="Drivers"
                      decoration-danger="is_license_expired or status == 'suspended'"
                      decoration-warning="status == 'off_duty'"
                      decoration-info="status == 'on_trip'"
                      decoration-success="status == 'available'">
                    <field name="name"/>
                    <field name="license_number"/>
                    <field name="license_category"/>
                    <field name="license_expiry"/>
                    <field name="is_license_expired" column_invisible="1"/>
                    <field name="safety_score"/>
                    <field name="contact_number"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'available'"
                           decoration-info="status == 'on_trip'"
                           decoration-warning="status == 'off_duty'"
                           decoration-danger="status == 'suspended'"/>
                </list>
            </field>
        </record>

        <!-- ── Form View ─────────────────────────────────────────────────────── -->
        <record id="view_transit_driver_form" model="ir.ui.view">
            <field name="name">transit.driver.form</field>
            <field name="model">transit.driver</field>
            <field name="arch" type="xml">
                <form string="Driver">
                    <header>
                        <field name="status" widget="statusbar"
                               statusbar_visible="available,on_trip,off_duty,suspended"/>
                    </header>
                    <sheet>
                        <!-- Smart button for trips -->
                        <div class="oe_button_box" name="button_box">
                            <button class="oe_stat_button" type="object"
                                    name="action_view_trips" icon="fa-truck">
                                <field name="trip_count" string="Trips" widget="statinfo"/>
                            </button>
                        </div>

                        <!-- TODO (Person A): Add a warning banner for expired license:
                             <div class="alert alert-danger" role="alert"
                                  invisible="not is_license_expired">
                                 ⚠️ This driver's license is expired! They cannot be assigned to trips.
                             </div>
                        -->
                        <div class="alert alert-danger" role="alert"
                             invisible="not is_license_expired">
                            <strong>⚠️ License Expired!</strong>
                            This driver cannot be assigned to any trips until the license is renewed.
                        </div>

                        <div class="oe_title">
                            <h1><field name="name" placeholder="Driver Full Name"/></h1>
                        </div>
                        <group>
                            <group string="License">
                                <field name="license_number"/>
                                <field name="license_category"/>
                                <field name="license_expiry"/>
                                <field name="is_license_expired" readonly="1"/>
                            </group>
                            <group string="Contact &amp; Safety">
                                <field name="contact_number"/>
                                <field name="safety_score"/>
                                <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <!-- TODO (Person A): Add widget="progressbar" for safety_score -->
                            </group>
                        </group>
                        <notebook>
                            <page string="Trip History">
                                <field name="trip_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="source"/>
                                        <field name="destination"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- ── Search View ───────────────────────────────────────────────────── -->
        <record id="view_transit_driver_search" model="ir.ui.view">
            <field name="name">transit.driver.search</field>
            <field name="model">transit.driver</field>
            <field name="arch" type="xml">
                <search string="Search Drivers">
                    <field name="name"/>
                    <field name="license_number"/>
                    <separator/>
                    <filter string="Available" name="available" domain="[('status','=','available')]"/>
                    <filter string="On Trip" name="on_trip" domain="[('status','=','on_trip')]"/>
                    <filter string="Off Duty" name="off_duty" domain="[('status','=','off_duty')]"/>
                    <filter string="Suspended" name="suspended" domain="[('status','=','suspended')]"/>
                    <separator/>
                    <filter string="Expired License" name="expired" domain="[('is_license_expired','=',True)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="License Category" name="group_category"
                                context="{'group_by':'license_category'}"/>
                        <filter string="Status" name="group_status" context="{'group_by':'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ── Window Action ─────────────────────────────────────────────────── -->
        <record id="action_transit_driver" model="ir.actions.act_window">
            <field name="name">Drivers</field>
            <field name="res_model">transit.driver</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_transit_driver_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Register your first driver!
                </p>
            </field>
        </record>

    </data>
</odoo>
