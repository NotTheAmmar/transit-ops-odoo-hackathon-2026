<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- MODULE CATEGORY -->
        <record id="module_category_transit_ops" model="ir.module.category">
            <field name="name">TransitOps</field>
            <field name="description">Smart Transport Operations Platform</field>
            <field name="sequence">50</field>
        </record>


        <!-- DRIVER GROUP -->
        <record id="group_transit_driver" model="res.groups">
            <field name="name">Driver</field>
            <field name="category_id" ref="module_category_transit_ops"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Can manage assigned trips.
                Can view operational records.
            </field>
        </record>


        <!-- SAFETY OFFICER -->
        <record id="group_transit_safety_officer" model="res.groups">
            <field name="name">Safety Officer</field>
            <field name="category_id" ref="module_category_transit_ops"/>
            <field name="implied_ids" eval="[(4, ref('group_transit_driver'))]"/>
            <field name="comment">
                Manages driver safety information.
                Can view operational records.
            </field>
        </record>


        <!-- FINANCIAL ANALYST -->
        <record id="group_transit_financial_analyst" model="res.groups">
            <field name="name">Financial Analyst</field>
            <field name="category_id" ref="module_category_transit_ops"/>
            <field name="implied_ids" eval="[(4, ref('group_transit_driver'))]"/>
            <field name="comment">
                Manages financial records,
                fuel logs and expenses.
            </field>
        </record>


        <!-- FLEET MANAGER -->
        <record id="group_transit_fleet_manager" model="res.groups">
            <field name="name">Fleet Manager</field>
            <field name="category_id" ref="module_category_transit_ops"/>

            <field name="implied_ids" eval="[
                (4, ref('group_transit_safety_officer')),
                (4, ref('group_transit_financial_analyst'))
            ]"/>

            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>

            <field name="comment">
                Full access to TransitOps operations.
            </field>
        </record>



        <!-- DRIVER CAN ONLY SEE OWN TRIPS -->
        <record id="rule_driver_own_trips" model="ir.rule">

            <field name="name">
                Drivers: Own Trips Only
            </field>

            <field name="model_id" ref="model_transit_trip"/>

            <field name="domain_force">
                [('driver_id.user_ids','in',[user.id])]
            </field>

            <field name="groups"
                eval="[(4, ref('group_transit_driver'))]"/>

        </record>



        <!-- OFFICERS AND MANAGER SEE ALL TRIPS -->
        <record id="rule_all_trips_for_officers" model="ir.rule">

            <field name="name">
                Officers and Managers: All Trips
            </field>

            <field name="model_id" ref="model_transit_trip"/>

            <field name="domain_force">
                [(1,'=',1)]
            </field>

            <field name="groups"
                eval="[
                (4, ref('group_transit_safety_officer')),
                (4, ref('group_transit_financial_analyst')),
                (4, ref('group_transit_fleet_manager'))
                ]"/>

        </record>


    </data>
</odoo>